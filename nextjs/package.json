{
  "name": "hunger-games",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "SKIP_ENV_VALIDATION=1 drizzle-kit studio",
    "dev": "dotenv cross-env NODE_ENV=development npm run run:server",
    "start": "dotenv cross-env NODE_ENV=production npm run run:server",
    "preview": "npm run build && npm run start",
    "run:server": "tsx src/server/server.ts",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "check": "next lint && tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "ts": "tsc --noEmit --incremental",
    "test": "dotenv cross-env NODE_ENV=test vitest run",
    "test:watch": "dotenv cross-env NODE_ENV=test vitest"
  },
  "dependencies": {
    "@clerk/backend": "^1.23.11",
    "@clerk/clerk-js": "^5.52.1",
    "@clerk/nextjs": "^6.11.1",
    "@radix-ui/react-accordion": "^1.2.3",
    "@radix-ui/react-alert-dialog": "^1.1.6",
    "@radix-ui/react-toast": "^1.2.6",
    "@t3-oss/env-nextjs": "^0.10.1",
    "@tanstack/react-query": "^5.67.2",
    "cross-env": "^7.0.3",
    "dotenv-cli": "^7.3.0",
    "drizzle-orm": "^0.33.0",
    "next": "^15.0.1",
    "postgres": "^3.4.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "temporal-polyfill": "^0.2.5",
    "tsx": "^4.19.2",
    "ws": "^8.18.0",
    "zod": "^3.23.3",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-navigation-menu": "^1.2.5",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-scroll-area": "^1.2.3",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.1.0",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/eslint": "^8.56.10",
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.5.13",
    "@typescript-eslint/eslint-plugin": "^8.1.0",
    "@typescript-eslint/parser": "^8.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@yudiel/react-qr-scanner": "^2.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.0.0",
    "drizzle-kit": "^0.24.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.0.1",
    "eslint-plugin-drizzle": "^0.2.3",
    "geist": "^1.3.0",
    "jsdom": "^25.0.1",
    "lucide-react": "^0.475.0",
    "postcss": "^8.4.39",
    "prettier": "^3.3.2",
    "prettier-plugin-tailwindcss": "^0.6.5",
    "react-hook-form": "^7.54.2",
    "react-icons": "^5.4.0",
    "react-qr-code": "^2.0.15",
    "rollup-plugin-node-externals": "^8.0.0",
    "tailwind-merge": "^3.0.1",
    "tailwindcss": "^3.4.3",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.5.3",
    "vite": "^6.1.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^2.1.8"
  },
  "ct3aMetadata": {
    "initVersion": "7.38.1"
  },
  "packageManager": "pnpm@8.14.0"
}
